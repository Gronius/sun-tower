---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/sections/Header.astro";
import Hero from "@components/sections/Hero.astro";
import About from "@components/sections/About.astro";
import Features from "@components/sections/Features.astro";
import Gallery from "@components/sections/Gallery.astro";
import Finder from "@components/sections/Finder.astro";
import Apartments from "@components/sections/Apartments.astro";
import FloorPlans from "@components/sections/FloorPlans.astro";
import Location from "@components/sections/Location.astro";
import CallToAction from "@components/sections/CallToAction.astro";
import Footer from "@components/sections/Footer.astro";
import Modal from "@components/ui/Modal.astro";
import ApartmentDetails from "@components/apartments/ApartmentDetails.astro";
---

<BaseLayout>
  <Header />
	<main>
		<Hero />
		<About />
		<Features />
		<Gallery />
		<Finder />
		<Apartments />
		<FloorPlans />
		<Location />
		<CallToAction />
	</main>

	<!-- <button id="test-modal">
  Відкрити модальне вікно
</button> -->

<Modal>

     <ApartmentDetails
    number="A-302"
    status="Заброньована"
    rooms={2}
    area={58.4}
    floor={3}
    section={1}
  />

</Modal>

	<Footer />
</BaseLayout>
