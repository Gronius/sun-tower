---
import LeadForm from "@components/ui/LeadForm.astro";

import ApartmentPlanLightbox from "@components/ui/ApartmentPlanLightbox.astro";
---


<article class="apartment-details">

  <header class="apartment-details__header">
    <div class="apartment-details__title">
      <h2 id="modal-apartment-number">A-302</h2>
      <span
        id="modal-apartment-status"
        class="apartment-details__status"
      >
        Вільна
      </span>
    </div>
  </header>

  <section class="apartment-details__specs">
    <ul class="apartment-details__info">
      <li>
        <span>Кімнати:</span>
        <strong id="modal-apartment-rooms">1</strong>
      </li>

      <li>
        <span>Площа:</span>
        <strong id="modal-apartment-area">42.8 м²</strong>
      </li>

      <li>
        <span>Поверх:</span>
        <strong id="modal-apartment-floor">1 поверх</strong>
      </li>

      <li>
        <span>Секція:</span>
        <strong id="modal-apartment-section">Секція B</strong>
      </li>

      <li>
        <span>Ціна:</span>
        <strong id="modal-apartment-price">145 000 €</strong>
      </li>
    </ul>
  </section>

  <section class="apartment-details__plan">
    <h3>Планування</h3>

    <div class="apartment-details__plan-image">
      <img
        id="modal-apartment-plan"
        src="/images/plans/plan-01_1.jpg"
        alt="Планування квартири"
        width="600"
        height="400"
      />
    </div>
  </section>

<section class="apartment-details__cta">
  <div class="apartment-details__cta-head">
    <h3>Запишіться на перегляд</h3>

    <p>
      Залиште свої контактні дані — ми зв’яжемося з вами
      та підберемо зручний час для перегляду.
    </p>
  </div>

  <LeadForm source="modal" />
</section>

<ApartmentPlanLightbox />

</article>