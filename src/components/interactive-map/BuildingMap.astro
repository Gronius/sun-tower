---
import SectionHeading from '../common/SectionHeading.astro' ;

import buildingOverlay from '/maps/building-overlay.svg?raw';
---

<section class="building-map-section">
  <div class="container">

    <SectionHeading
      badge="Вибір поверху"
      title="Оберіть поверх"
    />

    <p class="building-map-section__description">
      Наведіть курсор на поверх будинку, щоб переглянути його план
      та доступні квартири.
    </p>

    <div class="building-map">
      <img
        class="building-map__image"
        src="/maps/masterplan.jpg"
        alt="План території SUN TOWER"
        width="1600"
        height="800"
      />

       <div class="building-map__overlay" set:html={buildingOverlay}></div>

       <div class="building-map__tooltip"></div>
 
   </div>
        
  </div>
</section>

<style>
  .building-map-section {
  padding-block: 80px;
}
  .building-map {
    position: relative;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
  }
  .building-map__image {
    display: block;
    width: 100%;
    height: auto;
  }
  .building-map__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    /* pointer-events: none;  */
  }
  .building-map__overlay svg {
      width: 100%;
     height: 100%;
     display: block;
      pointer-events: auto; /* дозволяє ловити полігони */
  }
  .building-map__tooltip {
      position: absolute;
      z-index: 10;
      display: none;
      padding: 10px 14px;
      background: rgba(0, 0, 0, 0.75);
      color: #fff;
      font-size: 14px;
      line-height: 1.4;
      border-radius: 6px;
      pointer-events: none;
      white-space: nowrap;
      /* transform: translate(-50%, -100%); */
  } 

/* над курсором */
  .building-map__tooltip--top { 
    transform: translate(-50%, -100%); 
  }
  .building-map__tooltip--top::after {
     content: '';
      position: absolute;
      left: 50%;
      bottom: -6px;
      width: 0; 
      height: 0; 
      border-left: 6px solid transparent; 
      border-right: 6px solid transparent; 
      border-top: 6px solid rgba(0, 0, 0, 0.75); 
      transform: translateX(-50%); 
    }

    /* Tooltip праворуч від курсора */
    .building-map__tooltip--right { 
      transform: translateY(-50%); 
    }
    .building-map__tooltip--right::after { 
      content: ''; 
      position: absolute; 
      left: -6px; 
      top: 50%; 
      width: 0; 
      height: 0; 
      border-top: 6px solid transparent; 
      border-bottom: 6px solid transparent; 
      border-right: 6px solid rgba(0, 0, 0, 0.75); 
      transform: translateY(-50%); 
    }
     /* Tooltip ліворуч від курсора */
     .building-map__tooltip--left { 
      transform: translate(-100%, -50%); 
    } 
    .building-map__tooltip--left::after { 
      content: ''; 
      position: absolute; 
      right: -6px; 
      top: 50%; 
      width: 0; 
      height: 0; 
      border-top: 6px solid transparent; 
      border-bottom: 6px solid transparent; 
      border-left: 6px solid rgba(0, 0, 0, 0.75); 
      transform: translateY(-50%); 
    }


@media (max-width: 767px) {
  .building-map {
    width: 100%;
   }
  }
</style>

<script>
  import '../../scripts/interactive-map/building-map';
</script>


