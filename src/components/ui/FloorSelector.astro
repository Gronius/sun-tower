---
import { floors } from "@data/floors";
---

<div class="floor-selector">
  {
    floors.map((floor, index) => (
      <button
        class:list={[
          "floor-selector__button",
          index === 0 && "is-active",
        ]}
        type="button"
        data-floor={floor.floor}
        data-section={floor.section}
      >
        {floor.section} — {floor.floor} 
      </button>
    ))
  }
</div>