---
interface Props {
  text: string;
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}

const {
  text,
  href,
  type = "button",
  disabled = false,
  ...attrs
} = Astro.props as Props & Record<string, unknown>;
---

{
  href ? (
    <a
      class="button"
      href={href}
      {...attrs}
    >
      {text}
    </a>
  ) : (
    <button
      class="button"
      type={type}
      disabled={disabled}
      {...attrs}
    >
      {text}
    </button>
  )
}