---
interface Props {
  text: string;
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}

const {
  text,
  href,
  type = "button",
  disabled = false,
} = Astro.props as Props;
---

{
  href ? (
    <a class="button" href={href}>
      {text}
    </a>
  ) : (
    <button
      class="button"
      type={type}
      disabled={disabled}
    >
      {text}
    </button>
  )
}