---
import { floorSchemes } from "@data/floor-schemes";

const currentScheme = floorSchemes[0];
---

<div class="floor-scheme" >
  <div
    class="floor-scheme__image"
    data-floor-container
    data-floor-svg={currentScheme.svg}
  >
  </div>

    <div
    class="floor-scheme__tooltip"
    data-apartment-tooltip
    aria-hidden="true"
  ></div>

    <button
    class="floor-scheme__close"
    type="button"
    data-floor-scheme-close
    aria-label="Закрити план поверху"
      >
      Закрити план поверху
    </button>

</div>


