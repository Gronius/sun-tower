---
import { floorSchemes } from "@data/floor-schemes";

const currentScheme = floorSchemes[0];
---

<div
  class="floor-scheme"
  data-floor-container
>

  <div class="floor-scheme__image">

    <img
      src={currentScheme.svg}
      alt={currentScheme.title}
      data-floor-image
    />

  </div>

</div>