---
import { cta } from "@data/cta";

import LeadForm from "@components/ui/LeadForm.astro";
---

<section class="cta" id="consultation">

  <div class="container">

    <div class="cta__inner">

      <div class="cta__content">

        <span class="cta__badge">
          {cta.badge}
        </span>

        <h2 class="cta__title">
          {cta.title}
        </h2>

        <p class="cta__description">
          {cta.description}
        </p>

      </div>


    <div class="cta__form">

      <LeadForm
        source="cta"
       />

    </div>

     

    </div>

  </div>

</section>