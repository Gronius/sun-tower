---
import { apartments } from "@data/apartments";
import Button from "@components/ui/Button.astro";

const statusLabels = {
  free: "Вільна",
  reserved: "Зарезервована",
  sold: "Продана",
} as const;
---

<section class="apartments" id="apartments">
  <div class="container">

    <div class="apartments__heading">

      <span class="apartments__badge">
        Квартири
      </span>

      <h2 class="apartments__title">
        Доступні квартири
      </h2>

      <p class="apartments__description">
        Оберіть квартиру, яка найбільше відповідає вашим потребам.
      </p>

    </div>

    <div class="apartments__grid">

      
    {apartments
      .filter((apartment) => apartment.status === "free")
      .slice(0, 8)
      .map((apartment) => (

          <article 
            class="apartment-card"
            data-id={apartment.id}
            data-rooms={apartment.rooms}
            data-floor={apartment.floor}
            data-area={apartment.area}
            data-section={apartment.section}
            data-status={apartment.status}
          >

            <div class="apartment-card__content">

              <h3 class="apartment-card__title">
                {apartment.number}
              </h3>

              <ul class="apartment-card__list">

                <li>
                  Кімнат:
                  <strong>{apartment.rooms}</strong>
                </li>

                <li>
                  Площа:
                  <strong>{apartment.area} м²</strong>
                </li>

                <li>
                  Поверх:
                  <strong>{apartment.floor}</strong>
                </li>

                <li>
                  Секція:
                  <strong>{apartment.section}</strong>
                </li>

              </ul>

              <div class="apartment-card__footer">

              <span class="apartment-card__status">
                {statusLabels[apartment.status]}
              </span>

                <Button
                  text="Детальніше"
                  href="#"

                  data-modal-open
                  data-apartment-id={apartment.id}
                
                />

              </div>

            </div>

          </article>

        ))
      }

    </div>

     <div class="apartments__actions">
       <Button
    text="Переглянути всі квартири"
    href="#finder"
     />
    </div>

  </div>
</section>