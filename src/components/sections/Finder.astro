---
import Button from "@components/ui/Button.astro";
---

<section class="finder" id="finder">
  <div class="container">

    <div class="finder__heading">

      <span class="finder__badge">
        Пошук квартири
      </span>

      <h2 class="finder__title">
        Оберіть квартиру своєї мрії
      </h2>

      <p class="finder__description">
        Скористайтеся фільтрами, щоб швидко знайти квартиру,
        яка відповідає вашим побажанням.
      </p>

    </div>

    <form  id="finder-form" class="finder__form">

      <div class="finder__field">

        <label
          class="finder__label"
          for="rooms"
        >
          Кімнатність
        </label>

        <select
          id="rooms"
          name="rooms"
          class="finder__select"
        >
          <option value="">Усі</option>
          <option value="1">1 кімната</option>
          <option value="2">2 кімнати</option>
          <option value="3">3 кімнати</option>
          <option value="4">4 кімнати</option>
        </select>

      </div>

      <div class="finder__field">

        <label
          class="finder__label"
          for="section"
        >
          Секція
        </label>

        <select
          id="section"
          name="section"
          class="finder__select"
        >
          <option value="">Усі</option>
  
        </select>

      </div>

      <div class="finder__field">

        <label
          class="finder__label"
          for="floor"
        >
          Поверх
        </label>

        <select
          id="floor"
          name="floor"
          class="finder__select"
        >
          <option value="">Усі</option>
        </select>

      </div>

      <div class="finder__field">

        <label
          class="finder__label"
          for="area"
        >
          Площа
        </label>

        <select
          id="area"
          name="area"
          class="finder__select"
        >
          <option value="">Уся</option>
        </select>

      </div>

      <div class="finder__actions">

  <Button
    text="Показати"
    type="submit"
  />

  <button
    type="button"
    class="finder__reset"
  >
    Оновити
  </button>

</div>

    </form>

    <div class="finder__results">

      <div class="finder__results-header">

        <h3 class="finder__results-title">
          Результати пошуку
        </h3>

        <span class="finder__results-count"></span>

      </div>

      <div class="finder__results-list"></div>

    </div>


  </div>
</section>